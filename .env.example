# Copy to .env.local and fill in your Supabase project values.
# Dashboard: https://supabase.com/dashboard → Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Setup:
# 1. Create a Supabase project
# 2. Run supabase/migrations/001_initial_schema.sql in SQL Editor
# 3. Auth → URL Configuration → add redirect: http://localhost:3000/auth/callback
# 4. Auth → Providers → Email → turn OFF "Confirm email" so signup signs in immediately
# Stripe (bank payments for worker payouts and employer billing)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI (optional — enables GPT-powered assistant, job matching, and job drafts)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
